rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // IBRAHIM ENTERPRISE - FIRESTORE SECURITY RULES
    // Project: ibrahim-enterprise-6c8c8
    // =========================================================================

    // 1. Trade Inquiries Collection
    // Public visitors can create genuine trade quote requests with strict schema validation.
    // Read, update, and delete operations require authenticated staff credentials.
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.fullName.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 6
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.product is string
                    && request.resource.data.product.size() >= 2
                    && request.resource.data.consent == true;

      // Only authenticated trade desk staff can view, update status, or archive leads
      allow read, update, delete: if request.auth != null;
    }

    // 2. Default deny for all other collections
    match /{document=**} {
      allow read, write: false;
    }
  }
}
